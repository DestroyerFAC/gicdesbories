---
import { AGENDA_CATEGORIES, lastDay, type AgendaEvent } from '@/lib/agenda';
import { dayOfMonth, formatLongDate, formatTime, monthShort, weekdayShort } from '@/lib/dates';

interface Props {
  event: AgendaEvent;
  compact?: boolean;
  hidden?: boolean;
}

const { event, compact = false, hidden = false } = Astro.props;
const category = AGENDA_CATEGORIES[event.category];
const time =
  event.start === undefined
    ? null
    : event.end === undefined
      ? `à partir de ${formatTime(event.start)}`
      : `${formatTime(event.start)} – ${formatTime(event.end)}`;
---

<li
  class:list={['event', `event--${event.category}`, { 'event--compact': compact }]}
  data-category={event.category}
  data-end={lastDay(event)}
  hidden={hidden}
>
  <div class="event__stamp" aria-hidden="true">
    <span class="event__weekday">{weekdayShort(event.date)}</span>
    <span class="event__day">{dayOfMonth(event.date)}</span>
    <span class="event__month">{monthShort(event.date)}</span>
  </div>
  <div class="event__body">
    <p class="event__meta">
      <span class:list={['tag', `tag--${event.category}`]}>{category.label}</span>
      <time class="visually-hidden" datetime={event.date}>{formatLongDate(event.date)}</time>
    </p>
    <h3 class="event__title">{event.title}</h3>
    <p class="event__where">
      {time && <span class="event__time">{time}</span>}
      <span>{event.place}</span>
    </p>
    {!compact && event.details && <p class="event__details">{event.details}</p>}
  </div>
</li>

<style>
  .event {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-top: 1px solid var(--stone-300);
  }

  .event[hidden] {
    display: none;
  }

  .event__stamp {
    display: grid;
    justify-items: center;
    align-content: start;
    padding: 0.55rem 0.3rem 0.5rem;
    border-radius: var(--radius);
    background: var(--paper-2);
    box-shadow: inset 0 -3px 0 var(--stone-300);
    line-height: 1;
    text-align: center;
  }

  .event--battue .event__stamp {
    background: #f7e3d5;
    box-shadow: inset 0 -3px 0 #e9b89a;
  }

  .event__weekday,
  .event__month {
    font-family: var(--font-sc);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--ink-3);
  }

  .event__day {
    margin-block: 0.15rem 0.2rem;
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: 2.1rem;
    color: var(--ink);
  }

  .event__body {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .event__title {
    font-size: var(--step-1);
  }

  .event__where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.9rem;
    color: var(--ink-2);
  }

  .event__time {
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .event__details {
    max-width: 60ch;
    color: var(--ink-2);
  }

  .event--compact {
    grid-template-columns: 4rem 1fr;
    gap: var(--space-s);
  }

  .event--compact .event__day {
    font-size: 1.8rem;
  }
</style>
