---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DryStoneWall from '@/components/DryStoneWall.astro';
import NewsCard from '@/components/NewsCard.astro';
import { NEWS_CATEGORIES } from '@/data/actualites';
import { formatArticleDate } from '@/lib/dates';
import { getPublishedNews, type NewsEntry } from '@/lib/news';
import { withBase } from '@/lib/url';

export const getStaticPaths = (async () => {
  const news = await getPublishedNews();
  return news.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, others: news.filter((_, i) => i !== index).slice(0, 2) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: NewsEntry;
  others: NewsEntry[];
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article" publishedTime={entry.data.date}>
  <article class="article">
    <header class="article__header">
      <div class="container--narrow">
        <nav aria-label="Fil d’Ariane" class="breadcrumb">
          <a href={withBase('/actualites/')}>Actualités</a>
          <span aria-hidden="true">/</span>
          <span>{NEWS_CATEGORIES[entry.data.category]}</span>
        </nav>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        <p class="article__date">
          Publié le <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatArticleDate(entry.data.date)}</time>
        </p>
      </div>
    </header>
    <DryStoneWall variant="band" position="end" eager />

    <div class="section section--tight">
      <div class="container--narrow prose article__body">
        <Content />
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <aside class="section section--sand" aria-labelledby="autres-title">
        <div class="container">
          <div class="section-head section-head--row">
            <h2 id="autres-title">À lire aussi</h2>
            <a class="link-arrow" href={withBase('/actualites/')}>
              Toutes les actualités
            </a>
          </div>
          <ul class="grid-auto others" role="list">
            {others.map((other) => (
              <li>
                <NewsCard entry={other} />
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )
  }
</BaseLayout>

<style>
  .article__header {
    background: var(--paper-2);
    padding-block: var(--space-xl) var(--space-l);
  }

  .article__header .container--narrow {
    display: grid;
    gap: var(--space-s);
  }

  .article__header h1 {
    font-size: var(--step-4);
  }

  .article__header .lead {
    max-width: none;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-sc);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: var(--ochre-700);
  }

  .breadcrumb a {
    color: inherit;
  }

  .article__date {
    color: var(--ink-3);
  }

  .article__body {
    font-size: calc(var(--step-0) * 1.04);
  }

  .article__body :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink);
  }

  .others {
    --grid-min: 20rem;
  }
</style>
